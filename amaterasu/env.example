# Reference copy of everything the workflow passes to the bot.
# The workflow reads these from GitHub Secrets; this file is for local
# testing (`set -a; . ./env.example; set +a; bash scripts/run-bot.sh`)
# and as documentation of what each knob does.

# ── Required ─────────────────────────────────────────────────────────────
BOT_TOKEN=
TELEGRAM_API=
TELEGRAM_HASH=
OWNER_ID=
DATABASE_URL=

# ── Recommended ──────────────────────────────────────────────────────────
USER_SESSION_STRING=
WEB_ACCESS_PASSWORD=
HELPER_TOKENS=
LOG_CHAT_ID=

# ── Harness ──────────────────────────────────────────────────────────────
BOT_MINUTES=290
WORKER_URL=
WORKER_SECRET=
NTFY_TOPIC=

# ── Runtime defaults for an ephemeral runner ─────────────────────────────
PORT=8080
TIMEZONE=Asia/Kolkata
BIND_TO_LOOPBACK=True
CLOUDFLARE_TUNNEL_ENABLED=True
CLOUDFLARE_TUNNEL_AUTO_URL=True
CLOUDFLARE_TUNNEL_TARGET=http://127.0.0.1:8080
AUTO_UPDATE=False
UPDATE_PKGS=False
DISABLE_JD=True
DISABLE_NZB=True

# ── Size limits: keep these under your free disk ─────────────────────────
# Uncomment and tune. Values are in bytes unless the bot's docs say otherwise.
# DIRECT_LIMIT=20000000000
# TORRENT_LIMIT=20000000000
# LEECH_SPLIT_SIZE=2000000000
